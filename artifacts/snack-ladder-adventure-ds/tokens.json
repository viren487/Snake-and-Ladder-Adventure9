  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Nunito",
          "sans-serif"
        ],
        "$description": "Body and interface text."
      },
      "serif": {
        "$value": [
          "Fredoka",
          "sans-serif"
        ],
        "$description": "Playful display/headline face, retained as the serif slot for compatibility."
      },
      "mono": {
        "$value": [
          "DM Mono",
          "monospace"
        ],
        "$description": "Compact status labels and numeric metadata."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.85rem",
      "$description": "Extracted from the web game root radius."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel base spacing increment used by the utility scale."
    }
  }
